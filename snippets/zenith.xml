<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="zenith"
           fetch="https://github.com/ProjectZenithAOSP"
           sync-c="true"
           sync-j="4"
           revision="15-qpr1" />

  <remote  name="zenith-gitlab"
           fetch="https://gitlab.com/project-zenithaosp"
           sync-c="true"
           sync-j="4"
           revision="15-qpr1" />

  <!-- art -->
  <project path="art" name="art" groups="pdk" remote="zenith" />

  <!-- bionic -->
  <project path="bionic" name="bionic" groups="pdk" remote="zenith" />

  <!-- bootable -->
  <project path="bootable/deprecated-ota" name="bootable_deprecated-ota" groups="pdk-cw" remote="zenith" />
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk" remote="zenith" />

  <!-- build -->
  <project path="build/make" name="build_make" groups="pdk,sysui-studio" remote="zenith" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <project path="build/soong" name="build_soong" groups="pdk,tradefed" remote="zenith" >
  <project path="build/release" name="build_release" groups="pdk,tradefed" remote="zenith" />
  <project path="build/soong" name="build_soong" groups="pdk,tradefed" remote="zenith" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- external -->
  <project path="external/skia" name="external_skia" groups="pdk,qcom_msm8x26" remote="zenith" />

  <!-- frameworks -->
  <project path="frameworks/av" name="frameworks_av" groups="pdk" remote="zenith" />
  <project path="frameworks/base" name="frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="zenith" />
  <project path="frameworks/libs/systemui" name="frameworks_libs_systemui" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="zenith" />
  <project path="frameworks/native" name="frameworks_native" groups="pdk" remote="zenith" />

  <!-- hardware -->
  <project path="hardware/google/pixel-sepolicy" name="hardware_google_pixel-sepolicy" groups="generic_fs,pixel" remote="zenith" />

  <!-- manifest -->
  <project path="manifest" name="manifest" remote="zenith" />

  <!-- packages -->
  <project path="packages/apps/FaceUnlock" name="packages_apps_FaceUnlock" remote="zenith-gitlab" />
  <project path="packages/apps/Settings" name="packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc" remote="zenith" />
  <project path="packages/apps/ThemePicker" name="packages_apps_ThemePicker" groups="pdk-fs,sysui-studio" remote="zenith" />
  <project path="packages/modules/Connectivity" name="packages_modules_Connectivity" groups="pdk-cw-fs,pdk-fs" remote="zenith" />
  <project path="packages/services/Telecomm" name="packages_services_Telecomm" groups="pdk-cw-fs,pdk-fs" remote="zenith" />

  <!-- sepolicy -->
  <project path="device/lineage/sepolicy" name="device_lineage_sepolicy" remote="zenith" />
  <project path="device/mediatek/sepolicy_vndr" name="device_mediatek_sepolicy_vndr" remote="zenith" />

  <!-- system -->
  <project path="system/core" name="system_core" groups="pdk" remote="zenith" />
  <project path="system/sepolicy" name="system_sepolicy" groups="pdk" remote="zenith" />
  <project path="system/update_engine" name="system_update_engine" groups="pdk" remote="zenith" />

  <!-- vendor -->
  <project path="vendor/certification" name="vendor_certification" remote="zenith" />
  <project path="vendor/custom-preference" name="vendor_custom-preference" remote="zenith" />
  <project path="vendor/zenith" name="vendor_zenith" remote="zenith" />
  <project path="vendor/gms" name="vendor_gms" remote="zenith-gitlab" clone-depth="1" />

</manifest>
